{
  "id": "./ct.html",
  "name": "Νίκος CT Viewer",
  "short_name": "Νίκος CT",
  "description": "Προβολή αξονικών/μαγνητικών (DICOM) από CD, φάκελο ή δίκτυο: MPR, MIP, 3D, μετρήσεις. Χωρίς internet.",
  "start_url": "./ct?app=1",
  "scope": "./ct",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#0A0D11",
  "lang": "el",
  "icons": [
    {
      "src": "ct-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "ct-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./ct?app=1",
      "accept": {
        "application/dicom": [
          ".dcm",
          ".dicom"
        ],
        "application/x-nikos-ct": [
          ".nct"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}